# ==========================================
# AtmoPulse Repository Ignore List
# ==========================================

# 1. Python & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.conda/
.cache/
.cache.sqlite

# 2. Large Meteorological Datasets & Binaries
*.grib
*.nc
*.parquet
*.zarr/
*.part
ERA5_ClimateTool/

# 3. Security & API Keys (CRITICAL)
.env
.cdsapirc
.ecmwfapirc
*.log
secrets.toml

# 4. Media & Documentation (Assets to keep out of version control)
*.jpg
*.jpeg
*.png
*.docx
*.xlsx
*.pdf
LinkedIn Figures/

# 5. Local Snapshots & OS Files
_backup_*/
backup_*/
.DS_Store
Thumbs.db
~$*
Appending
Downloading
Precomputing
Updating